@baseUrl = http://localhost:3000

### 1. GET all courses -- expect 200
GET {{baseUrl}}/api/courses

### 2. GET one course -- expect 200
GET {{baseUrl}}/api/courses/1

### 3. GET a course that does not exist -- expect 404
POST {{baseUrl}}/api/courses
Content-Type: application/json

{
  "number": "CSC4600",
  "title": "Cloud Computing",
  "credits": 3,
  "description": "Test course",
  "prerequisites": [5,9]
}

### 4. PUT -- update a course previously created -- expect 200
PUT {{baseUrl}}/api/courses/7
Content-Type: application/json

{
  "number": "CSC3700",
  "title": "Advanced Web Application Development",
  "credits": 3,
  "description": "React, Node/Express, MySQL, JWT authentication.",
  "prerequisites": [3, 5]
}

### 5. DELETE -- remove a course -- expect 200
DELETE {{baseUrl}}/api/courses/9

### 6. GET completed courses -- expect 200
GET {{baseUrl}}/api/completions


### 7. PUT -- save completed courses -- expect 200
PUT {{baseUrl}}/api/completions
Content-Type: application/json

[1, 3, 2]

### 8. GET a course that doesn't exist -- expect 404
GET {{baseUrl}}/api/courses/999

### 9.POST a course with missing course info -- expect 400
POST {{baseUrl}}/api/courses
Content-Type: application/json

{
  "number": "CSC4800",
  "description": "Missing title and credits"
}

### 10. PUT a course as completed without completed prerequisites -- expect 400
PUT {{baseUrl}}/api/completions
Content-Type: application/json

[10]
